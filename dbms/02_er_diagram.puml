@startuml Real_Time_Land_Acquisition_ERD
!theme plain
skinparam linetype ortho

entity "users" as users {
  * user_id : INTEGER <<PK>>
  --
  * name : VARCHAR(100)
  * email : VARCHAR(150) <<UK>>
  * role : VARCHAR(20)
  * created_at : TIMESTAMP
}

entity "owners" as owners {
  * owner_id : INTEGER <<PK>>
  --
  * full_name : VARCHAR(100)
  * phone : VARCHAR(15)
  * id_number : VARCHAR(50) <<UK>>
  * created_at : TIMESTAMP
}

entity "parcels" as parcels {
  * parcel_id : INTEGER <<PK>>
  --
  * survey_number : VARCHAR(50) <<UK>>
  * village : VARCHAR(100)
  * area_sqm : DECIMAL(12,2)
  * market_rate_per_sqm : DECIMAL(12,2)
  * created_at : TIMESTAMP
}

entity "parcel_owners" as parcel_owners {
  * parcel_id : INTEGER <<PK, FK>>
  * owner_id : INTEGER <<PK, FK>>
  --
  * share_percent : DECIMAL(5,2)
  * created_at : TIMESTAMP
}

entity "projects" as projects {
  * project_id : INTEGER <<PK>>
  --
  * name : VARCHAR(150)
  * department : VARCHAR(100)
  * budget : DECIMAL(15,2)
  * created_at : TIMESTAMP
}

entity "acquisitions" as acquisitions {
  * acquisition_id : INTEGER <<PK>>
  --
  * parcel_id : INTEGER <<FK>>
  * project_id : INTEGER <<FK>>
  * status : VARCHAR(30)
  * created_by : INTEGER <<FK>>
  * created_at : TIMESTAMP
  * updated_at : TIMESTAMP
}

entity "compensations" as compensations {
  * compensation_id : INTEGER <<PK>>
  --
  * acquisition_id : INTEGER <<FK>>
  * owner_id : INTEGER <<FK>>
  * amount : DECIMAL(15,2)
  * payment_status : VARCHAR(20)
  payment_date : TIMESTAMP
  * created_at : TIMESTAMP
}

entity "objections" as objections {
  * objection_id : INTEGER <<PK>>
  --
  * acquisition_id : INTEGER <<FK>>
  * owner_id : INTEGER <<FK>>
  * reason : TEXT
  * status : VARCHAR(20)
  * filed_at : TIMESTAMP
  resolved_at : TIMESTAMP
}

entity "status_history" as status_history {
  * history_id : INTEGER <<PK>>
  --
  * acquisition_id : INTEGER <<FK>>
  old_status : VARCHAR(30)
  * new_status : VARCHAR(30)
  * changed_by : INTEGER <<FK>>
  * changed_at : TIMESTAMP
}

users ||..o{ acquisitions : "creates"
users ||..o{ status_history : "logs"
projects ||..o{ acquisitions : "initiates"
parcels ||..|{ parcel_owners : "divided into"
owners ||..|{ parcel_owners : "holds share"
parcels ||..o{ acquisitions : "acquired in"
acquisitions ||..|{ status_history : "audit tracks"
acquisitions ||..o{ compensations : "awards"
owners ||..o{ compensations : "receives"
acquisitions ||..o{ objections : "disputed by"
owners ||..o{ objections : "files"

@enduml
