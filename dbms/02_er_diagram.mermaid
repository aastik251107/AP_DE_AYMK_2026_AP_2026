erDiagram
    USERS ||--o{ ACQUISITIONS : "creates"
    USERS ||--o{ STATUS_HISTORY : "records"
    PROJECTS ||--o{ ACQUISITIONS : "initiates"
    PARCELS ||--|{ PARCEL_OWNERS : "has"
    OWNERS ||--|{ PARCEL_OWNERS : "owns"
    PARCELS ||--o{ ACQUISITIONS : "acquired_in"
    ACQUISITIONS ||--|{ STATUS_HISTORY : "tracks"
    ACQUISITIONS ||--o{ COMPENSATIONS : "awards"
    OWNERS ||--o{ COMPENSATIONS : "receives"
    ACQUISITIONS ||--o{ OBJECTIONS : "has_disputes"
    OWNERS ||--o{ OBJECTIONS : "files"

    USERS {
        int user_id PK
        string name
        string email UK
        string role
        timestamp created_at
    }

    OWNERS {
        int owner_id PK
        string full_name
        string phone
        string id_number UK
        timestamp created_at
    }

    PARCELS {
        int parcel_id PK
        string survey_number UK
        string village
        decimal area_sqm
        decimal market_rate_per_sqm
        timestamp created_at
    }

    PARCEL_OWNERS {
        int parcel_id PK "FK to PARCELS"
        int owner_id PK "FK to OWNERS"
        decimal share_percent
        timestamp created_at
    }

    PROJECTS {
        int project_id PK
        string name
        string department
        decimal budget
        timestamp created_at
    }

    ACQUISITIONS {
        int acquisition_id PK
        int parcel_id FK
        int project_id FK
        string status
        int created_by FK
        timestamp created_at
        timestamp updated_at
    }

    COMPENSATIONS {
        int compensation_id PK
        int acquisition_id FK
        int owner_id FK
        decimal amount
        string payment_status
        timestamp payment_date
        timestamp created_at
    }

    OBJECTIONS {
        int objection_id PK
        int acquisition_id FK
        int owner_id FK
        string reason
        string status
        timestamp filed_at
        timestamp resolved_at
    }

    STATUS_HISTORY {
        int history_id PK
        int acquisition_id FK
        string old_status
        string new_status
        int changed_by FK
        timestamp changed_at
    }
